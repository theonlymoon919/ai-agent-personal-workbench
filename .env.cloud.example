WORKBENCH_DOMAIN=workbench.example.com
WORKBENCH_PUBLIC_ORIGIN=https://workbench.example.com
WORKBENCH_SECURE_COOKIES=true
WORKBENCH_PORT=8787
POSTGRES_DB=workbench
POSTGRES_USER=workbench_owner
POSTGRES_PASSWORD=replace-with-a-long-random-value
WORKBENCH_DB_RUNTIME_PASSWORD=replace-with-a-different-long-random-value
WORKBENCH_TOKEN_PEPPER=replace-with-at-least-32-random-characters
WORKBENCH_DB_POOL_SIZE=3
WORKBENCH_DB_MAX_OVERFLOW=2
# Set this to the repository's published package, for example:
WORKBENCH_IMAGE=ghcr.io/your-github-account/ai-agent-personal-workbench
WORKBENCH_IMAGE_TAG=latest
