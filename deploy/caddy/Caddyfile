    encode zstd gzip
    request_body {
        max_size 16MB
    }
    header {
        -Server
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy no-referrer
        Permissions-Policy "camera=(self), microphone=(), geolocation=()"
        Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: blob: https:; media-src 'self' blob: https:; frame-src https:; connect-src 'self' wss: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; worker-src 'self' blob:"
    }
    reverse_proxy workbench:8787
}
